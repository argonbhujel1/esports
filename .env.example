# ESPORTS Worlds - Environment Variables
# Never commit real secrets

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/esports_worlds?sslmode=require

# Flask
SECRET_KEY=generate-a-long-random-string-at-least-64-chars
SESSION_SECRET=another-long-random-string
JWT_SECRET=jwt-secret-long-random-string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional SMTP for OTP/email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@esports.argan.com.np

# App URLs
PUBLIC_URL=https://esports.argan.com.np
ADMIN_URL=https://crm.argan.com.np
AGENT_URL=https://agent.argan.com.np
API_URL=https://api.argan.com.np

# Feature flags
MAINTENANCE_MODE=false
ENABLE_REGISTRATION=true

# Rate limiting
RATELIMIT_STORAGE_URI=memory://
# For production prefer Redis: redis://... or Upstash
